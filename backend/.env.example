# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS - Add your frontend URLs (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_FILE_SIZE_MB=10

# Google Cloud Storage (optional for local dev)
# Leave empty to use local storage (uploads/ folder)
# For production: set these to enable GCS with public URLs
GCS_BUCKET_NAME=
GCP_PROJECT_ID=
GCS_CREDENTIALS_PATH=

# Example with GCS enabled:
# GCS_BUCKET_NAME=pplx-london-space-uploads
# GCP_PROJECT_ID=my-test-project-475121
# GCS_CREDENTIALS_PATH=service-account-key.json

VERTEX_AI_PROJECT=my-test-project-475121  # defaults to GCP_PROJECT_ID
VERTEX_AI_LOCATION=us-central1  # default
GEMINI_MODEL=gemini-2.5-flash